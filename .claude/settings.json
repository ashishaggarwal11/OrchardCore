{
  "permissions": {
    "allow": [
      "Bash(dotnet:*)"
    ],
    "ask": [
      "Bash(git:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "Bash(git push --force:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-cs-style.sh",
            "timeout": 120,
            "async": true,
            "statusMessage": "Checking style/analyzers..."
          }
        ]
      }
    ]
  }
}
